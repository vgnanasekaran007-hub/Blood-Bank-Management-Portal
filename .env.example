# ====================================================================
# LifePulse Blood Portal - Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GITHUB
# ====================================================================

# Django Core
SECRET_KEY=your-secure-random-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=*.onrender.com,*.vercel.app,localhost,127.0.0.1

# Supabase / PostgreSQL Database Connection String
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Frontend API Base URL (for Vercel deployment)
# Example: https://blood-bank-portal-backend.onrender.com/api
API_BASE_URL=http://127.0.0.1:8000/api

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://lifepulse-portal.vercel.app,http://localhost:3000,http://127.0.0.1:3000
